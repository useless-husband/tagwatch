// V("assembly", access, size, effective address)
// The assembly column is assembled by the real assembler at build time (see
// the Makefile), so the decoder is tested against genuine encodings.
// Register file used by the test: Xn = 0x100000 * (n + 1) + n, except
// X2 = 0xffffffff80000010 (to exercise sign/zero extension); SP = 0x7fff0000.
V("ldr x0, [x1]", R, 8, X(1))
V("ldr w0, [x1, #4]", R, 4, X(1) + 4)
V("ldr x2, [x3, #32760]", R, 8, X(3) + 32760)
V("ldrb w0, [x1, #3]", R, 1, X(1) + 3)
V("ldrh w0, [x1, #6]", R, 2, X(1) + 6)
V("ldrsb x0, [x1, #1]", R, 1, X(1) + 1)
V("ldrsb w0, [x1, #1]", R, 1, X(1) + 1)
V("ldrsh x0, [x1, #2]", R, 2, X(1) + 2)
V("ldrsh w0, [x1, #2]", R, 2, X(1) + 2)
V("ldrsw x0, [x1, #8]", R, 4, X(1) + 8)
V("str x0, [x1]", W, 8, X(1))
V("str w5, [x9, #12]", W, 4, X(9) + 12)
V("strb w0, [x1, #4095]", W, 1, X(1) + 4095)
V("strh w0, [x1, #2]", W, 2, X(1) + 2)
V("ldur x0, [x1, #-8]", R, 8, X(1) - 8)
V("ldur w0, [x1, #3]", R, 4, X(1) + 3)
V("stur x0, [x1, #-256]", W, 8, X(1) - 256)
V("sturb w0, [x1, #-1]", W, 1, X(1) - 1)
V("ldursw x0, [x1, #-4]", R, 4, X(1) - 4)
V("ldr x0, [x1], #8", R, 8, X(1))
V("ldr x0, [x1, #8]!", R, 8, X(1) + 8)
V("str x0, [x1], #-16", W, 8, X(1))
V("str x0, [x1, #-16]!", W, 8, X(1) - 16)
V("strb w2, [x3], #1", W, 1, X(3))
V("ldrb w2, [x3, #1]!", R, 1, X(3) + 1)
V("ldr x0, [x1, x2]", R, 8, X(1) + X(2))
V("ldr x0, [x1, x2, lsl #3]", R, 8, X(1) + (X(2) << 3))
V("ldr w0, [x1, w2, uxtw]", R, 4, X(1) + (uint32_t)X(2))
V("ldr w0, [x1, w2, uxtw #2]", R, 4, X(1) + ((uint64_t)(uint32_t)X(2) << 2))
V("ldr x0, [x1, w2, sxtw #3]", R, 8, X(1) + ((uint64_t)(int64_t)(int32_t)X(2) << 3))
V("strb w0, [x1, x2]", W, 1, X(1) + X(2))
V("strh w0, [x1, x2, lsl #1]", W, 2, X(1) + (X(2) << 1))
V("ldrsw x0, [x1, x2, lsl #2]", R, 4, X(1) + (X(2) << 2))
V("ldp x0, x1, [x2]", R, 16, X(2))
V("ldp x0, x1, [x2, #16]", R, 16, X(2) + 16)
V("ldp w0, w1, [x2, #-8]", R, 8, X(2) - 8)
V("stp x0, x1, [x2, #-512]", W, 16, X(2) - 512)
V("stp x29, x30, [x2, #-16]!", W, 16, X(2) - 16)
V("ldp x29, x30, [x2], #16", R, 16, X(2))
V("stp w3, w4, [x5], #8", W, 8, X(5))
V("ldpsw x0, x1, [x2, #8]", R, 8, X(2) + 8)
V("stnp x0, x1, [x2, #32]", W, 16, X(2) + 32)
V("ldnp q0, q1, [x2, #64]", R, 32, X(2) + 64)
V("ldr q0, [x1]", R, 16, X(1))
V("ldr q0, [x1, #32]", R, 16, X(1) + 32)
V("str q1, [x2, #16]", W, 16, X(2) + 16)
V("ldr d0, [x1, #8]", R, 8, X(1) + 8)
V("str s0, [x1, #4]", W, 4, X(1) + 4)
V("ldr h0, [x1, #2]", R, 2, X(1) + 2)
V("str b0, [x1, #1]", W, 1, X(1) + 1)
V("ldur q0, [x1, #-16]", R, 16, X(1) - 16)
V("stur q0, [x1, #1]", W, 16, X(1) + 1)
V("str q0, [x1, x2]", W, 16, X(1) + X(2))
V("ldr q0, [x1, x2, lsl #4]", R, 16, X(1) + (X(2) << 4))
V("ldr d0, [x1, x2, lsl #3]", R, 8, X(1) + (X(2) << 3))
V("stp q0, q1, [x2]", W, 32, X(2))
V("ldp q0, q1, [x2, #32]", R, 32, X(2) + 32)
V("stp d0, d1, [x2, #-16]!", W, 16, X(2) - 16)
V("ldp s0, s1, [x2], #8", R, 8, X(2))
V("ld1 {v0.16b}, [x1]", R, 16, X(1))
V("ld1 {v0.8b}, [x1]", R, 8, X(1))
V("ld1 {v0.16b, v1.16b}, [x1]", R, 32, X(1))
V("ld1 {v0.16b, v1.16b, v2.16b}, [x1]", R, 48, X(1))
V("ld1 {v0.16b, v1.16b, v2.16b, v3.16b}, [x1]", R, 64, X(1))
V("st1 {v0.16b, v1.16b, v2.16b, v3.16b}, [x1], #64", W, 64, X(1))
V("st1 {v0.2d}, [x1], x2", W, 16, X(1))
V("ld2 {v0.4s, v1.4s}, [x1]", R, 32, X(1))
V("ld3 {v0.8b, v1.8b, v2.8b}, [x1]", R, 24, X(1))
V("st4 {v0.2d, v1.2d, v2.2d, v3.2d}, [x1]", W, 64, X(1))
V("ld1 {v0.b}[3], [x1]", R, 1, X(1))
V("ld1 {v0.h}[1], [x1]", R, 2, X(1))
V("ld1 {v0.s}[1], [x1]", R, 4, X(1))
V("ld1 {v0.d}[1], [x1]", R, 8, X(1))
V("st1 {v0.s}[2], [x1], #4", W, 4, X(1))
V("st2 {v0.d, v1.d}[1], [x1]", W, 16, X(1))
V("ld3 {v0.h, v1.h, v2.h}[0], [x1]", R, 6, X(1))
V("ld4 {v0.b, v1.b, v2.b, v3.b}[5], [x1]", R, 4, X(1))
V("ld1r {v0.4s}, [x1]", R, 4, X(1))
V("ld2r {v0.2d, v1.2d}, [x1]", R, 16, X(1))
V("ldxr x0, [x1]", R, 8, X(1))
V("ldaxr w0, [x1]", R, 4, X(1))
V("ldxrb w0, [x1]", R, 1, X(1))
V("stxr w2, x0, [x1]", W, 8, X(1))
V("stlxr w2, w0, [x1]", W, 4, X(1))
V("stxrh w2, w0, [x1]", W, 2, X(1))
V("ldxp x0, x1, [x2]", R, 16, X(2))
V("stxp w3, x0, x1, [x2]", W, 16, X(2))
V("ldaxp w0, w1, [x2]", R, 8, X(2))
V("ldar x0, [x1]", R, 8, X(1))
V("ldarb w0, [x1]", R, 1, X(1))
V("stlr x0, [x1]", W, 8, X(1))
V("stlrh w0, [x1]", W, 2, X(1))
V("cas x0, x1, [x2]", RW, 8, X(2))
V("casal w0, w1, [x2]", RW, 4, X(2))
V("casb w0, w1, [x2]", RW, 1, X(2))
V("casp x0, x1, x2, x3, [x4]", RW, 16, X(4))
V("caspal w0, w1, w2, w3, [x4]", RW, 8, X(4))
V("ldadd x0, x1, [x2]", RW, 8, X(2))
V("ldaddal w0, w1, [x2]", RW, 4, X(2))
V("ldclrb w0, w1, [x2]", RW, 1, X(2))
V("ldeorh w0, w1, [x2]", RW, 2, X(2))
V("ldsetal x0, x1, [x2]", RW, 8, X(2))
V("ldsmax x0, x1, [x2]", RW, 8, X(2))
V("ldumin w0, w1, [x2]", RW, 4, X(2))
V("swp x0, x1, [x2]", RW, 8, X(2))
V("swpalb w0, w1, [x2]", RW, 1, X(2))
V("ldapr x0, [x1]", R, 8, X(1))
V("ldapur x0, [x1, #-8]", R, 8, X(1) - 8)
V("ldapur w0, [x1, #4]", R, 4, X(1) + 4)
V("stlur x0, [x1, #8]", W, 8, X(1) + 8)
V("ldapursw x0, [x1, #4]", R, 4, X(1) + 4)
V("ldtr x0, [x1, #8]", R, 8, X(1) + 8)
V("sttrb w0, [x1, #1]", W, 1, X(1) + 1)
V("dc zva, x3", W, 64, X(3) & ~63ull)
V("ldr x0, [sp, x1]", R, 8, SP + X(1))
// Pointer-authenticated loads: width is known, the address is not derivable.
V("ldraa x0, [x1]", R, 8, 0)
V("ldrab x0, [x1, #8]!", R, 8, 0)
// Not tag-checked or not memory accesses: the decoder must reject these.
V("ldr x0, 0", NONE, 0, 0)
V("prfm pldl1keep, [x1]", NONE, 0, 0)
V("prfm pldl1keep, [x1, x2]", NONE, 0, 0)
V("prfum pldl1keep, [x1, #-8]", NONE, 0, 0)
V("stg x0, [x1]", NONE, 0, 0)
V("stzg x0, [x1, #16]!", NONE, 0, 0)
V("st2g x0, [x1], #32", NONE, 0, 0)
V("ldg x0, [x1]", NONE, 0, 0)
V("stgp x0, x1, [x2]", NONE, 0, 0)
V("irg x0, x1", NONE, 0, 0)
V("add x0, x1, x2", NONE, 0, 0)
V("mov x0, #1", NONE, 0, 0)
V("b .", NONE, 0, 0)
V("bl .", NONE, 0, 0)
V("cbz x0, .", NONE, 0, 0)
V("adr x0, .", NONE, 0, 0)
V("ret", NONE, 0, 0)
V("svc #0x80", NONE, 0, 0)
V("mrs x0, tpidrro_el0", NONE, 0, 0)
V("msr tco, #1", NONE, 0, 0)
V("dc cvau, x0", NONE, 0, 0)
V("dc gva, x0", NONE, 0, 0)
V("fadd d0, d1, d2", NONE, 0, 0)
V("clrex", NONE, 0, 0)
V("brk #1", NONE, 0, 0)
