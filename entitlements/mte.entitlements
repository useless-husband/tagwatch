<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The two keys that turn MTE on for a binary started directly. Tested on
     macOS 27.0: either key alone is not enough. See the README for the
     codesign command. -->
<plist version="1.0"><dict>
<key>com.apple.security.hardened-process</key><true/>
<key>com.apple.security.hardened-process.checked-allocations</key><true/>
</dict></plist>
